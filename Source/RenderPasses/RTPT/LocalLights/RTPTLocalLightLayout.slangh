#define RTPT_LIGHT_KIND_EMISSIVE 2u
#define RTPT_LIGHT_KIND_ANALYTIC 3u

#define RTPT_LIGHT_QUERY_MAIN_PRIMARY 0u
#define RTPT_LIGHT_QUERY_SECONDARY 1u
#define RTPT_LIGHT_QUERY_TRAINING 2u
#define RTPT_LIGHT_QUERY_PROBE 3u

#define RTPT_LIGHT_SOURCE_GLOBAL 0u
