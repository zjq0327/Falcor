#define RTPT_LOCAL_INSPECT_HISTORY_INFO 9u
#define RTPT_LOCAL_INSPECT_HISTORY_POSITION 10u
#define RTPT_LOCAL_INSPECT_HISTORY_NORMAL 11u
#define RTPT_LOCAL_INSPECT_EVENT_POSITION 12u
#define RTPT_LOCAL_INSPECT_EVENT_NORMAL 13u
#define RTPT_LOCAL_INSPECT_EVENT_TARGET 14u
#define RTPT_LOCAL_INSPECT_EVENT_DIRECTION 15u
#define RTPT_LOCAL_INSPECT_EVENT_IDENTITY 16u
#define RTPT_LOCAL_INSPECT_EVENT_CONTEXT 17u
#define RTPT_LOCAL_INSPECT_EVENT_GENERATION 18u
