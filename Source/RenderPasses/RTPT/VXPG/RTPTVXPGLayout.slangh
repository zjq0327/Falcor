#pragma once

// Shared CPU/Slang word layout. Values are the existing GPU ABI, including
// reserved words. Offsets below are uint32 words; CPU dispatches convert to bytes.
#ifdef __cplusplus
#include <cstdint>
namespace RTPTVXPG
{
#define RTPT_VXPG_LAYOUT_UINT inline constexpr std::uint32_t
#else
#define RTPT_VXPG_LAYOUT_UINT static const uint
#endif

RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_INVALID = 0xffffffffu;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORD_BYTES = 4;

// gVXPGState: model state and optional per-frame rendering/training counters.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_JOBS = 0;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_GEOMETRY_OVERFLOW = 1;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_OCCUPIED = 2; // Cell-ID high-water mark.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_ACTIVE = 3;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_DISTRIBUTION_OVERFLOW = 4;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_READY = 5; // Published generation, or zero.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_ATTEMPTS = 6;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_ACCEPTED = 7;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_REJECTED = 8;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_SELF_REJECTED = 9;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_PG_CACHE_HITS = 10;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_INVALID = 11;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_INJECTED = 12;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_PG_CACHE_CHECKS = 13;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_PRIMARY_ATTEMPTS = 14;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_SECOND_ATTEMPTS = 15;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_INJECT_SHADOW = 16;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_INJECT_PRIMARY = 17;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_INJECT_SECONDARY = 18;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_GUIDE_RAYS = 19;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_BRDF_RAYS = 20;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_PRIMARY_RAYS = 21;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_PG_SHADOW = 22;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_MAIN_SHADOW = 23;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_BRDF_CACHE_HITS = 24;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_POSITIVE_PAIRS = 25;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_GATHERED_POINTS = 26;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_OWNER_MAX_PROBES = 27;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_SHARED_PATHS = 28;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_OWNER_QUERIES = 29;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_OWNER_PROBES = 30;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_FULL_BRANCH_STEPS = 31;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_STATE_WORDS = 32;

// Bit flags stored in STATE_DISTRIBUTION_OVERFLOW.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_OVERFLOW_ACTIVE_CAPACITY = 1;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_OVERFLOW_FLUX = 2;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_OVERFLOW_OBSERVATION_COUNT = 4;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_OVERFLOW_OBSERVATION = 6; // Flux or count.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_OVERFLOW_SCREEN_PREFIX = 8;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_OVERFLOW_SCREEN_SCATTER = 16;

// gVXPGTreeState: words 11..15 remain reserved.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_FULL_BUILD = 0;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_PREVIOUS_ACTIVE = 1;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_DIRTY_LEAVES = 2;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_FULL_BUILDS = 3;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_LOCAL_UPDATES = 4;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_GLOBAL_NODES = 5;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_FOREST_NODES = 6;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_TOPOLOGY_AGE = 7;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_TOPOLOGY_VALID = 8;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_MEMBERSHIP_CHANGES = 9;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_REBUILD_REASON = 10;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_TREE_WORDS = 16;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_REBUILD_RESET = 1;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_REBUILD_PERIODIC = 2;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_REBUILD_MEMBERSHIP = 4;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_REBUILD_INVALID = 8;

// gVXPGGridState: words 9..15 remain reserved.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_GRID_FREE = 0;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_GRID_PENDING = 1;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_GRID_RETIRED = 2;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_GRID_INSERTED = 3;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_GRID_EVICTED = 4;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_GRID_CAPACITY_REJECTS = 5;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_GRID_LIVE = 6;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_GRID_REUSED = 7;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_GRID_DISCOVERY_REJECTS = 8;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_GRID_WORDS = 16;

// gVXPGClusterState persists while frozen; word 7 remains reserved.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_CLUSTER_VALID_SUPERPIXELS = 0;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_CLUSTER_NONEMPTY = 1;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_CLUSTER_VISIBILITY_RAYS = 2;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_CLUSTER_VISIBLE_PAIRS = 3;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_CLUSTER_FOREST_NODES = 4;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_CLUSTER_TOP_ROWS = 5;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_CLUSTER_READY = 6;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_CLUSTER_WORDS = 8;

// gVXPGHistoryStats: word 7 remains reserved.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_HISTORY_VALID = 0;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_HISTORY_CARRIED = 1;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_HISTORY_EXPIRED = 2;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_HISTORY_UPDATED = 3;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_HISTORY_BORROWED = 4;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_HISTORY_NORMAL_REJECTS = 5;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_HISTORY_BORROWED_TOTAL = 6;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_HISTORY_WORDS = 8;

// gVXPGQueryStats: words 4 and 7 remain reserved.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_QUERY_FORWARD_COUNT = 0;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_QUERY_FORWARD_STEPS = 1;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_QUERY_REVERSE_COUNT = 2;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_QUERY_REVERSE_STEPS = 3;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_QUERY_FORWARD_MAX_DEPTH = 5;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_QUERY_REVERSE_MAX_DEPTH = 6;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_QUERY_WORDS = 8;

// DispatchIndirect records, also used by gVXPGLocalArgs/gVXPGClusterArgs.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_DISPATCH_X = 0;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_DISPATCH_Y = 1;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_DISPATCH_Z = 2;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_DISPATCH_WORDS = 3;

// gVXPGWorkArgs: header at 0..2; fixed records and per-level records below.
// Gaps and the unused tail are reserved; the allocation stays 256 words.
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_LEAF_BASE = 0;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_SORT_CAPACITY = 1;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_SORT_GROUPS = 2;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_GEOMETRY = 4;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_ACTIVE = 8;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_GLOBAL_LEAVES = 12;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_SORT = 16;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_FOREST_NODES = 20;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_GLOBAL_LEVELS = 32;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_FOREST_LEVELS = 96;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_LEVEL_COUNT = 18;
RTPT_VXPG_LAYOUT_UINT RTPT_VXPG_WORK_WORDS = 256;

#undef RTPT_VXPG_LAYOUT_UINT
#ifdef __cplusplus
static_assert(sizeof(std::uint32_t) == RTPT_VXPG_WORD_BYTES);
static_assert(RTPT_VXPG_STATE_SECOND_ATTEMPTS == RTPT_VXPG_STATE_PRIMARY_ATTEMPTS + 1);
static_assert(RTPT_VXPG_OVERFLOW_OBSERVATION == (RTPT_VXPG_OVERFLOW_FLUX | RTPT_VXPG_OVERFLOW_OBSERVATION_COUNT));
static_assert(RTPT_VXPG_WORK_GLOBAL_LEVELS + RTPT_VXPG_WORK_LEVEL_COUNT * RTPT_VXPG_DISPATCH_WORDS <= RTPT_VXPG_WORK_FOREST_LEVELS);
static_assert(RTPT_VXPG_WORK_FOREST_LEVELS + RTPT_VXPG_WORK_LEVEL_COUNT * RTPT_VXPG_DISPATCH_WORDS <= RTPT_VXPG_WORK_WORDS);
} // namespace RTPTVXPG
#endif
